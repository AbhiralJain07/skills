//in this we'll learn linear searching 

package linearsearch;

public class Main {
    public static void main(String[] args) {
        int[] nums = {23,45,1,2,8,19,-3,16,-11,28};
        int target = 19;
        int ans = linearsearch (nums , target);
        System.out.println(ans);
    }

    // Search in the array: return index if found
    // otherwise if not found return -1

    static int linearsearch(int[] arr, int target) { 
        if (arr.length == 0){
            return -1;
        }

        // run for loop

        for (int i = 0; i<arr.length; i++){
            // check for element at every index if it is equal to target
            int element = arr[i];
            if (element == target){
                return i;
            }  
     }
            
        

        // this line will execute if none of the returm statements above have been executed

        // hence taregt not found

        return -1 ;
    }
}
